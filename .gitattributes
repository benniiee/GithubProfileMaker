# Normalize line endings for everyone, regardless of OS/editor
* text=auto eol=lf

# Binary files — never let git try to diff or convert line endings on these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

*.svg text eol=lf

# Mark build output as generated so GitHub's diff view and language stats ignore it
dist/** linguist-generated=true
